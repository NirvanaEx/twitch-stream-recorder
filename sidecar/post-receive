#!/usr/bin/env bash
set -euo pipefail
deploy=0
while read -r oldrev newrev ref; do
  if [[ "$ref" == "refs/heads/main" ]]; then deploy=1; fi
done
if [[ "$deploy" != 1 ]]; then exit 0; fi
exec 9>/tmp/twitch-sync-deploy.lock
flock -n 9 || exit 1
exec > >(tee -a /var/log/twitch-sync-deploy.log) 2>&1
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
exec python3 /root/projects/twitch-sync/sidecar/deploy.py
