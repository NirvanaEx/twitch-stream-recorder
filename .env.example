POSTGRES_DB=twitch_recorder
POSTGRES_USER=twitch_recorder
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://twitch_recorder:change_me@localhost:5432/twitch_recorder

REDIS_PORT=6379
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000
NGINX_PORT=9000

JWT_SECRET=change_me_too
# First-run bootstrap: a superadmin user is created with these credentials
# only if no users exist in the DB. Change the password later from the UI
# (Account page). These values are NOT re-checked on subsequent starts.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=123

APP_BASE_URL=http://localhost:9000

# Optional. If left blank, the app uses public Streamlink-based fallback mode.
# Fill these only if you want official Twitch Helix API lookups and EventSub readiness.
# Register an app in the Twitch developer console:
# https://dev.twitch.tv/console/apps
# Docs: https://dev.twitch.tv/docs/authentication/register-app
# For local development, use http://localhost:3000 as the redirect URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick. Fully optional — Kick channels work without any of this.
# Left empty, channel lookups and live polling borrow streamlink's HTTP session
# (scripts/kick-channel.py), which is the only thing here that gets past
# kick.com's bot check. Filling in a developer app from
# https://kick.com/settings/developer switches those to the documented
# api.kick.com instead: no Python subprocess per poll and no reliance on an
# undocumented endpoint. Chat capture always uses the streamlink path, because
# the official API does not expose the chatroom id it needs.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Only needed when you configure Twitch API credentials and want EventSub.
# EventSub secret must be ASCII and 10-100 characters.
# Example: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=

# --- Recording safety ---
# Free space the data disk must have before a capture may start (GB). A
# recording holds the streamlink .ts and the remuxed .mp4 at once, so budget
# about twice the finished file (~16 GB for a 3h 1080p60 stream). Running out
# mid-remux leaves an unplayable .mp4 that can never be offloaded to Telegram
# and therefore never gets cleaned up.
# RECORDING_MIN_FREE_GB=20

# --- Telegram storage (optional) ---
# Uploads finished recordings to a Telegram channel to free local disk space
# and streams them back into the web player on demand.
#
# All three credentials are normally entered in the admin panel
# (Settings -> Telegram storage); the env vars below are only an optional
# fallback for headless setups.
# 1. Get api_id/api_hash at https://my.telegram.org.
# 2. Create a bot via @BotFather and copy its token.
# 3. Create a private channel, add the bot as admin, put the channel id
#    (-100...) or @username into the admin settings.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
# Max size of one uploaded part in MB (Telegram's hard limit for bots is 2000).
# TELEGRAM_MAX_PART_MB=1900
# How many 512 KB chunks the player streaming reads from Telegram in parallel
# (1-32). Higher = faster playback/seeking at the cost of more requests.
# TELEGRAM_STREAM_PARALLELISM=6
# RAM cache for streamed chunks, MB (0 disables). Speeds up seeking and
# timeline previews by serving recently fetched ranges without Telegram.
# Lives OUTSIDE the Node heap — keep it modest on small servers.
# TELEGRAM_STREAM_CACHE_MB=64
# How many viewers may stream from Telegram at the same time (1-16). All of
# them share one MTProto connection; more concurrent streams = each one
# slower and more RAM held by in-flight chunks.
# TELEGRAM_STREAM_MAX_CONCURRENT=3

# --- Archive tier (mounted drive, optional) ---
# Where finished recordings live once they leave the server disk. On this
# server it is the 5 TB Google Drive that rclone mounts at /mnt/gdrive; any
# other mount works the same way.
#
# Recordings are always CAPTURED to DATA_DIR — a network mount cannot take the
# thousands of small appends streamlink and ffmpeg produce — and only the
# finished files are moved across, after Telegram has taken its copy from the
# fast local original. Each session becomes one self-contained folder:
#
#   <ARCHIVE_DIR>/<platform>/<login>/<YYYY-MM>/<stamp>__<title>__<id>/
#       video.mp4  audio.m4a  chat.tsr.json  cover.jpg  session.json
#
# How long they stay is set in the admin panel (Settings -> Storage), 90 days
# by default. Expiry deletes the folder and leaves the Telegram copy, which
# playback falls back to automatically — and it never fires while Telegram has
# no copy, so the last copy of a recording can never be the one that expires.
#
# The tier disables itself unless ARCHIVE_DIR/.archive-root is readable. Create
# that marker once, by hand, on the mounted drive:
#     mkdir -p /mnt/gdrive/twitch-recorder
#     echo 'do not delete' > /mnt/gdrive/twitch-recorder/.archive-root
# Without the marker a dropped mount would look like a healthy empty archive
# and recordings would quietly fill the server's own disk under the mount
# point. With it, a dropped mount simply means "disk + Telegram, as before",
# and the backlog drains by itself once the mount is back.
#
# Leave ARCHIVE_DIR empty to switch the tier off entirely.
# ARCHIVE_DIR=/mnt/gdrive/twitch-recorder
# Host path bind-mounted into the api container. Must be the PARENT of the
# mount point, at the same path inside the container, or restarting rclone
# leaves the container attached to a dead mount.
# ARCHIVE_HOST_DIR=/mnt

# --- Memory ceilings (docker-compose) ---
# Hard caps so one runaway service can never freeze the whole server (which
# used to surface as 502 from nginx until a manual reboot). Raise API limits
# if the host has plenty of RAM and you want a bigger stream cache.
# API_HEAP_MB=512        # V8 heap inside the api container
# API_MEM_LIMIT=1200m    # api container total (node + streamlink + ffmpeg)
# WEB_HEAP_MB=256
# WEB_MEM_LIMIT=384m
# POSTGRES_MEM_LIMIT=384m
# REDIS_MEM_LIMIT=96m
# NGINX_MEM_LIMIT=64m

DATA_DIR=./data
