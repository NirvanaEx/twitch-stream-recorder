POSTGRES_DB=twitch_recorder
POSTGRES_USER=twitch_recorder
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://twitch_recorder:change_me@localhost:5432/twitch_recorder

REDIS_PORT=6379
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379

API_PORT=3001
WEB_PORT=3000
NGINX_PORT=9000

JWT_SECRET=change_me_too
# First-run bootstrap: a superadmin user is created with these credentials
# only if no users exist in the DB. Change the password later from the UI
# (Account page). These values are NOT re-checked on subsequent starts.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=123

APP_BASE_URL=http://localhost:9000

# Optional. If left blank, the app uses public Streamlink-based fallback mode.
# Fill these only if you want official Twitch Helix API lookups and EventSub readiness.
# Register an app in the Twitch developer console:
# https://dev.twitch.tv/console/apps
# Docs: https://dev.twitch.tv/docs/authentication/register-app
# For local development, use http://localhost:3000 as the redirect URL.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Only needed when you configure Twitch API credentials and want EventSub.
# EventSub secret must be ASCII and 10-100 characters.
# Example: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=

DATA_DIR=./data
